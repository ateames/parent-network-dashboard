# Copy to infra/.env and adjust. Never commit real secrets.
#   cp infra/.env.example infra/.env

# --- PostgreSQL (db service) ---
POSTGRES_USER=parent
POSTGRES_PASSWORD=parent
POSTGRES_DB=parent_network
# Host port published for local tooling (optional)
POSTGRES_PORT=5432

# Async SQLAlchemy URL used by api + worker (host `db` is the Compose service name).
DATABASE_URL=postgresql+asyncpg://parent:parent@db:5432/parent_network

# --- Upstream LAN hosts (placeholders; read-only ingestion) ---
PIHOLE_URL=http://pihole.local
# Auth: none | password (Pi-hole v6 SID) | token (legacy auth= query param)
PIHOLE_AUTH_METHOD=password
PIHOLE_PASSWORD=
PIHOLE_TOKEN=
PIHOLE_QUERIES_PATH=/api/queries
PIHOLE_AUTH_PATH=/api/auth
PIHOLE_POLL_INTERVAL_SECONDS=60
PIHOLE_QUERY_LENGTH=100
PIHOLE_VERIFY_TLS=false
UNIFI_URL=https://unifi.local
# Auth: session (username/password cookie) | token (API key / bearer)
UNIFI_AUTH_METHOD=session
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_TOKEN=
UNIFI_SITE=default
UNIFI_LOGIN_PATH=/api/login
UNIFI_CLIENTS_PATH=/api/s/{site}/stat/sta
UNIFI_DEVICES_PATH=/api/s/{site}/stat/device
UNIFI_NETWORKS_PATH=/api/s/{site}/rest/networkconf
UNIFI_EVENTS_PATH=/api/s/{site}/stat/event
# Classic stamgr for Disable Internet (session auth required; ignored in token mode)
UNIFI_STAMGR_PATH=/api/s/{site}/cmd/stamgr
UNIFI_POLL_INTERVAL_SECONDS=60
UNIFI_EVENTS_LIMIT=100
UNIFI_VERIFY_TLS=false

# UniFi syslog listener (controller → Pi only; never writes back to UniFi)
# See docs/unifi-syslog.md for controller UI steps.
UNIFI_SYSLOG_ENABLED=true
UNIFI_SYSLOG_HOST=0.0.0.0
UNIFI_SYSLOG_PORT=5514
UNIFI_SYSLOG_PROTOCOLS=udp,tcp
UNIFI_SYSLOG_STALE_SECONDS=300
UNIFI_SYSLOG_HEALTH_CHECK_SECONDS=60

# --- Source health thresholds (seconds / consecutive failure count) ---
SOURCE_HEALTH_STALE_SECONDS=300
SOURCE_HEALTH_MAX_FAILURES=3

# --- Local admin credentials (server-side only; never expose to the browser) ---
# ADMIN_TOKEN is injected by the Next.js proxy when calling the API.
# DASHBOARD_* gates the UI login (cookie session); it never receives ADMIN_TOKEN.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_TOKEN=changeme

# Dashboard UI login (frontend container only — never NEXT_PUBLIC_*)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
# Long random string used to sign the httpOnly session cookie
DASHBOARD_SESSION_SECRET=change-me-to-a-long-random-string
# Set true only when the UI is served over HTTPS (LAN HTTP must stay false)
DASHBOARD_COOKIE_SECURE=false

# Encrypts Pi-hole / UniFi / optional dashboard passwords stored in Postgres.
# Any string works; install.sh generates a random value. Falls back to ADMIN_TOKEN if empty.
CONNECTIONS_SECRET=change-me-to-a-long-random-string

# --- App identity (git-independent build metadata for GET /version) ---
APP_VERSION=0.1.0
BUILD_ID=local

# --- API publish port ---
API_PORT=8000

# --- Frontend publish port ---
FRONTEND_PORT=3000

# --- Frontend (SERVER-ONLY — read by Next.js route handlers / Docker runtime) ---
# Never prefix these with NEXT_PUBLIC_. The browser must only call /api/proxy/*.
# In Compose, the frontend reaches the API via the service name `api`.
BACKEND_URL=http://api:8000
# ADMIN_TOKEN is reused above — the proxy attaches it as Authorization: Bearer …

