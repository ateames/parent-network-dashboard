# Copy to infra/.env and adjust. Never commit real secrets.
#   cp infra/.env.example infra/.env

# --- PostgreSQL (db service) ---
POSTGRES_USER=parent
POSTGRES_PASSWORD=parent
POSTGRES_DB=parent_network
# Host port published for local tooling (optional)
POSTGRES_PORT=5432

# Async SQLAlchemy URL used by api + worker (host `db` is the Compose service name).
DATABASE_URL=postgresql+asyncpg://parent:parent@db:5432/parent_network

# --- Upstream LAN hosts (placeholders; read-only ingestion later) ---
PIHOLE_URL=http://pihole.local
UNIFI_URL=https://unifi.local

# --- Local admin credentials (server-side only; never expose to the browser) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_TOKEN=changeme

# --- App identity (git-independent build metadata for GET /version) ---
APP_VERSION=0.1.0
BUILD_ID=local

# --- API publish port ---
API_PORT=8000
